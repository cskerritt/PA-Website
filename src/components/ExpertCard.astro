---
import { SITE } from '../config/site';

// Photo-less by design: no headshots and no credential logo badge strips.
// Leadership facts below mirror personJsonLd() in src/lib/jsonld.ts; the
// evaluation figure is read from SITE.stats, the single gated source of
// displayed statistics (LAUNCH-CHECKLIST item 2).
const leadership = [
  'President, Board of Directors, American Rehabilitation Economics Association (AREA)',
  'Board of Directors and Fellow, American Board of Vocational Experts (ABVE)',
  'Board of Directors and Forensic Section Representative, International Association of Rehabilitation Professionals (IARP), 2022 to 2024',
];

const evalStat =
  SITE.stats.find((stat) => stat.label.includes('vocational evaluations')) ?? null;
---
<div class="expert-card">
  <div class="expert-identity">
    <h3 class="expert-name">{SITE.principal}</h3>
    <p class="expert-creds">{SITE.principalCreds}</p>
    <p class="expert-role">
      Principal of {SITE.legalName}. Vocational expert and Certified Life Care Planner.
    </p>
    {evalStat && <p class="expert-stat">{evalStat.value} {evalStat.label}</p>}
    <p class="expert-note">
      Forensic economic analyses are performed and signed by independent economist partners
      coordinated by the firm.
    </p>
    <a class="btn btn-secondary" href="/experts/jason-purinton/">View full profile</a>
  </div>
  <ul class="expert-leadership">
    {leadership.map((line) => (
      <li>
        <svg
          class="cred-glyph"
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
        >
          <rect x="1.5" y="1.5" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.5" />
          <path d="M4.75 8.25 7 10.5l4.25-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{line}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  /* The card spans the container so its edges align with the section rule;
     inside, identity sits left and the leadership ledger right. */
  .expert-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--orange);
    border-radius: 10px;
    padding: 2rem 2.25rem 2.1rem;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .expert-card { grid-template-columns: 1fr; }
  }

  .expert-name {
    font-size: 1.75rem;
    line-height: 1.15;
    margin-bottom: 0.3rem;
  }

  /* The credential rule runs the full column width, aligned to the card's
     internal grid rather than stopping mid-air at a text measure. */
  .expert-creds {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-deep);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    max-width: none;
  }

  .expert-role {
    margin-bottom: 0.35rem;
  }

  .expert-stat {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 1.1rem;
  }

  /* Single-column ruled ledger: a divider under every row that exists, none
     dangling under absent ones. */
  .expert-leadership {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
    position: relative;
  }

  .expert-leadership::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 32px;
    height: 2px;
    background: var(--orange);
  }

  .expert-leadership li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    border-bottom: 1px solid var(--hairline);
    padding-block: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: none;
  }

  .expert-leadership li:last-child { border-bottom: 0; }

  .cred-glyph {
    flex-shrink: 0;
    margin-top: 0.22rem;
    color: var(--teal-deep);
  }

  .expert-note {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-bottom: 1.4rem;
  }
</style>
