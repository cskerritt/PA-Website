---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NeutralityStatement from '../../components/NeutralityStatement.astro';
import ProofBand from '../../components/ProofBand.astro';
import CTABand from '../../components/CTABand.astro';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
  const entries = await getCollection('locations');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'locations'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const path = `/locations/${entry.id}/`;
const isHub = entry.id === 'nationwide';

// Metro pages hang off the national coverage hub in the breadcrumb trail.
const crumbs = isHub
  ? [
      { name: 'Home', path: '/' },
      { name: 'National Coverage', path },
    ]
  : [
      { name: 'Home', path: '/' },
      { name: 'National Coverage', path: '/locations/nationwide/' },
      { name: data.city ?? data.title, path },
    ];

// Office facts come from the entity record only. All offices are by
// appointment with no street address (accuracy guardrail), so this panel
// renders city/region contact facts and nothing more.
const office = SITE.offices.find((o) => o.slug === entry.id);
const otherOffices = office ? SITE.offices.filter((o) => o.slug !== entry.id) : [];
---
<BaseLayout title={data.title} description={data.metaDescription} path={path}>
  <div class="container content-narrow">
    <Breadcrumbs crumbs={crumbs} />
    <h1>{data.h1}</h1>
    <NeutralityStatement />

    {office && (
      <aside class="loc-office-facts" aria-label={`${office.city} contact details`}>
        <dl>
          <div>
            <dt>Location</dt>
            <dd>{office.city}, {office.region} (meetings by appointment)</dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a href={`tel:${SITE.phoneE164}`}>{SITE.phoneDisplay}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
          </div>
          <div>
            <dt>Also serving counsel from</dt>
            <dd>
              {otherOffices.map((o, i) => (
                <>
                  {i > 0 ? ' · ' : ''}<a href={`/locations/${o.slug}/`}>{o.city}</a>
                </>
              ))}
              {' '}and <a href="/locations/nationwide/">nationwide</a>
            </dd>
          </div>
        </dl>
      </aside>
    )}

    <div class="loc-body">
      <Content />
    </div>
  </div>

  {isHub && <ProofBand />}
  <CTABand />
</BaseLayout>

<style>
  .loc-office-facts {
    background: var(--white);
    border: 1px solid var(--line);
    border-left: 4px solid var(--navy);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }

  .loc-office-facts dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 0;
  }

  .loc-office-facts dt {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
  }

  .loc-office-facts dd {
    margin: 0.15rem 0 0;
    font-weight: 500;
  }

  .loc-body :global(h2) {
    margin-top: 2rem;
  }
</style>
