---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofBand from '../components/ProofBand.astro';
import NeutralityStatement from '../components/NeutralityStatement.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ExpertCard from '../components/ExpertCard.astro';
import FAQBlock from '../components/FAQBlock.astro';
import CTABand from '../components/CTABand.astro';
import { SITE } from '../config/site';
import { orgJsonLd, webSiteJsonLd } from '../lib/jsonld';

const title = `${SITE.brand} | Forensic Damages and Rehabilitation Experts`;
const description =
  'Nationwide vocational expert, life care planning, and economic damages services for plaintiff and defense counsel, coordinated by Purinton Analytics.';

// Section 1: hero. The H1 is the verbatim national positioning line from the
// design spec (SITE.tagline); the lede carries the strategy plan's hero copy.
const heroLede =
  'Purinton Analytics coordinates vocational evaluation, life care planning, and forensic economic damages analysis for litigation nationwide. The firm provides objective litigation support for plaintiff and defense counsel in personal injury, medical malpractice, wrongful death, employment, and disability matters, with evaluations, depositions, and trial testimony available remotely and in person in all 50 states.';

// Section 3: the three principal disciplines. Economic analyses are performed
// and signed by independent economist partners, never by the firm's principal.
const disciplines = [
  {
    name: 'Vocational Expert Services',
    href: '/services/vocational-expert-witness/',
    text: 'Employability, placeability, earning capacity, transferable skills, and labor market access opinions, with deposition and trial testimony nationwide.',
  },
  {
    name: 'Life Care Planning',
    href: '/services/life-care-planning/',
    text: 'Future care needs and costs for catastrophic injury, documented by a Certified Life Care Planner on a foundation of medical records and treating provider input.',
  },
  {
    name: 'Forensic Economic Damages',
    href: '/services/forensic-economic-damages/',
    text: 'Present value analyses of lost earning capacity, household services, and life care costs, performed and signed by independent economist partners coordinated by the firm.',
  },
];

const supportingServices = [
  { name: 'medical cost projections', href: '/services/medical-cost-projection/' },
  {
    name: 'rebuttal and peer review of opposing expert reports',
    href: '/services/rebuttal-peer-review/',
  },
  {
    name: 'expert testimony and litigation consulting',
    href: '/services/expert-testimony-litigation-consulting/',
  },
].map((service, i, all) => ({
  ...service,
  separator: i === all.length - 1 ? '. ' : i === all.length - 2 ? ', and ' : ', ',
}));

// Section 6: the matter grid reads the matters collection so it grows as
// content lands. Canonical display order per the build plan; labels fall back
// to each entry's own H1 for any slug not listed here.
const MATTER_ORDER = [
  'personal-injury',
  'medical-malpractice',
  'wrongful-death',
  'pediatric-birth-injury',
  'employment-litigation',
  'family-law',
  'workers-compensation',
  'erisa-long-term-disability',
  'product-liability-mass-tort',
  'veterans-tdiu',
];

const MATTER_LABELS: Record<string, string> = {
  'personal-injury': 'Personal Injury',
  'medical-malpractice': 'Medical Malpractice',
  'wrongful-death': 'Wrongful Death',
  'pediatric-birth-injury': 'Pediatric and Birth Injury',
  'employment-litigation': 'Employment Litigation',
  'family-law': 'Family Law',
  'workers-compensation': "Workers' Compensation",
  'erisa-long-term-disability': 'ERISA Long-Term Disability',
  'product-liability-mass-tort': 'Product Liability and Mass Tort',
  'veterans-tdiu': 'Veterans TDIU',
};

const rank = (id: string) => {
  const i = MATTER_ORDER.indexOf(id);
  return i === -1 ? MATTER_ORDER.length : i;
};

const matters = (await getCollection('matters')).sort(
  (a, b) => rank(a.id) - rank(b.id) || a.id.localeCompare(b.id),
);

// Section 9: coverage strip is built from SITE.offices (no street addresses;
// every office outside the Kansas City base is by appointment).
const appointmentCities = SITE.offices
  .filter((office) => !('primary' in office))
  .map((office) => office.city);
const appointmentList =
  appointmentCities.length > 1
    ? `${appointmentCities.slice(0, -1).join(', ')}, and ${appointmentCities.at(-1)}`
    : appointmentCities.join('');

// Section 10: featured records checklists (full resource pages, printable).
const featuredResources = [
  {
    name: 'Vocational Evaluation Records Checklist',
    href: '/resources/vocational-evaluation-records-checklist/',
    text: 'The education, employment, wage, and medical records a vocational evaluation is built on.',
  },
  {
    name: 'Life Care Plan Records Checklist',
    href: '/resources/life-care-plan-records-checklist/',
    text: 'The medical, therapy, medication, and equipment records a life care plan requires.',
  },
  {
    name: 'Economic Loss Records Checklist',
    href: '/resources/economic-loss-records-checklist/',
    text: 'The tax, wage, and benefits records independent economist partners rely on for signed damages analyses.',
  },
];

// Section 11: referral FAQs. FAQBlock renders the visible questions and the
// FAQPage JSON-LD from this same array, so schema and page cannot drift.
const referralFaqs = [
  {
    q: 'Do you accept both plaintiff and defense referrals?',
    a: 'Yes. Purinton Analytics accepts engagements from plaintiff and defense counsel and applies the same documented methodology regardless of which side issues the retention letter. Opinions are written to withstand review by opposing counsel and cross-examination on either side of the caption.',
  },
  {
    q: 'What happens after I request a conflict check?',
    a: 'We review the case caption and parties against current and prior engagements and respond promptly, typically the same day during business hours, with availability, CVs, and fee information. Substantive discussion of the case begins only after the conflict check clears.',
  },
  {
    q: 'Who performs and signs the economic damages analysis?',
    a: 'Independent economist partners coordinated by the firm perform and sign all economic damages analyses. Jason C. Purinton provides the vocational and life care planning opinions. Each opinion is authored, signed, and defended by an expert qualified in that discipline.',
  },
  {
    q: 'Should I send records with my initial referral?',
    a: 'No. Do not send medical records, Social Security numbers, dates of birth, financial records, or other confidential documents with the initial request. After the conflict check clears, we provide a secure method for sending records along with a checklist of what the analysis requires.',
  },
  {
    q: 'Can you meet a short disclosure, deposition, or trial deadline?',
    a: `Often, yes. Expedited handling is available when the record can responsibly support it, and rebuttal and peer review engagements are frequently completed on compressed schedules. Call ${SITE.phoneDisplay} with the operative dates and we will confirm what is achievable before you commit.`,
  },
  {
    q: 'Is testimony available outside Missouri?',
    a: 'Yes. Evaluations, depositions, and trial testimony are available in all 50 states, remotely where the court and the referral questions permit and in person where they do not. Travel logistics and costs are addressed in the fee information provided before retention.',
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path="/"
  jsonld={[orgJsonLd(), webSiteJsonLd()]}
>
  {/* 1. Hero: asymmetric two-column, copy left, exhibit card right */}
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow fx fx-1">National litigation support</p>
        <h1 class="fx fx-2">{SITE.tagline}</h1>
        <p class="hero-lede fx fx-3">{heroLede}</p>
        <div class="hero-actions fx fx-4">
          <a class="btn btn-primary" href="/refer-a-case/">Request a Conflict Check</a>
          <a class="btn btn-light" href="/contact/#cv-fee">Request CVs and Fee Information</a>
        </div>
        <p class="hero-urgent fx fx-5">
          Imminent disclosure, deposition, or trial deadline?
          <a href={`tel:${SITE.phoneE164}`}>Call {SITE.phoneDisplay}</a>
        </p>
      </div>
      {/* 2. Proof stats (SITE.stats only), presented as the hero exhibit card */}
      <div class="hero-exhibit fx fx-6">
        <ProofBand variant="exhibit" />
      </div>
    </div>
  </section>

  {/* 3. Three principal disciplines */}
  <section class="page-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Services</p>
        <h2>Vocational, life care planning, and economic expertise</h2>
        <p class="lead">
          Each discipline answers a different damages question. Retain one analysis or the
          coordinated team; either way, every opinion stays within its author's professional
          boundaries.
        </p>
      </div>
      <div class="card-grid">
        {disciplines.map((d, i) => (
          <a class="card" href={d.href} data-reveal style={`--reveal-delay:${i * 40}ms`}>
            <h3>{d.name}</h3>
            <p>{d.text}</p>
          </a>
        ))}
      </div>
      <p class="more-services" data-reveal>
        Also available:
        {supportingServices.map((s) => (
          <>
            <a href={s.href}>{s.name}</a>{s.separator}
          </>
        ))}
        <a href="/services/">View all services</a>.
      </p>
    </div>
  </section>

  {/* 4. Coordinated damages assessment explainer */}
  <section class="coordinated">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Coordinated engagement</p>
        <h2>One coordinated engagement, clearly separated expert roles</h2>
      </div>
      <p>
        For catastrophic injury and other complex damages cases, counsel can retain the full
        damages team through a single conflict-checked referral. The vocational expert
        establishes what work remains available and what it pays. The life care planner
        documents future care needs and their costs. Independent economist partners convert
        those findings into signed present value analyses. Each expert forms and defends
        independent opinions, so the analyses connect without blurring the lines between
        disciplines.
      </p>
      <a class="btn btn-secondary" href="/services/coordinated-damages-assessment/">
        How the coordinated damages assessment works
      </a>
    </div>
  </section>

  {/* 5. Neutrality statement band */}
  <div class="container content-narrow">
    <NeutralityStatement />
  </div>

  {/* 6. Matter-type grid */}
  <section class="page-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Matters</p>
        <h2>Matters we support</h2>
        <p class="lead">
          Vocational, life care, and economic questions appear across the litigation landscape.
          Select a matter type to see which analyses typically apply and what they address.
        </p>
      </div>
      {matters.length > 0 && (
        <div class="card-grid matters-grid">
          {matters.map((matter, i) => (
            <a
              class="card"
              href={`/matters/${matter.id}/`}
              data-reveal
              style={`--reveal-delay:${i * 40}ms`}
            >
              <h3>{MATTER_LABELS[matter.id] ?? matter.data.h1}</h3>
            </a>
          ))}
        </div>
      )}
      <p class="section-link" data-reveal>
        <a href="/matters/">How we support each matter type</a>
      </p>
    </div>
  </section>

  {/* 7. Four-step engagement process */}
  <div class="container content-narrow" data-reveal>
    <ProcessSteps />
  </div>

  {/* 8. Expert card */}
  <section class="page-section">
    <div class="container content-narrow">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Experts</p>
        <h2>The firm's principal</h2>
      </div>
      <div data-reveal style="--reveal-delay:60ms">
        <ExpertCard />
      </div>
    </div>
  </section>

  {/* 9. National coverage strip */}
  <section class="coverage">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Coverage</p>
        <h2>National coverage</h2>
      </div>
      <p>
        Purinton Analytics is based in {SITE.city}, Missouri, with offices available by
        appointment in {appointmentList}. Referrals are accepted from all 50 states.
        Evaluations, depositions, and trial testimony proceed remotely or in person, and labor
        market and medical cost research is built from published federal, state, and regional
        data for the venue at issue.
      </p>
      <p class="section-link">
        <a href="/locations/nationwide/">Learn about national coverage</a>
      </p>
    </div>
  </section>

  {/* 10. Featured resources: records checklists */}
  <section class="page-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Resources</p>
        <h2>Records checklists for counsel</h2>
        <p class="lead">
          Records drive every forensic analysis. These printable checklists let counsel start
          collection before the expert is retained.
        </p>
      </div>
      <div class="card-grid">
        {featuredResources.map((r, i) => (
          <a class="card" href={r.href} data-reveal style={`--reveal-delay:${i * 40}ms`}>
            <h3>{r.name}</h3>
            <p>{r.text}</p>
          </a>
        ))}
      </div>
      <p class="section-link" data-reveal>
        <a href="/resources/">Browse all attorney resources</a>
      </p>
    </div>
  </section>

  {/* 11. Referral FAQs (visible + FAQPage JSON-LD from the same data) */}
  <section class="page-section">
    <div class="container content-narrow" data-reveal>
      <FAQBlock faqs={referralFaqs} heading="Common referral questions" />
    </div>
  </section>

  {/* 12. Final CTA band */}
  <CTABand />
</BaseLayout>

<style>
  /* The Expert Report hero: layered navy-ink gradient under the analysis
     grid, with a faint radial glow top-left. Pure CSS, no images. */
  .hero {
    background:
      var(--grid-texture),
      radial-gradient(1100px 620px at 10% -12%, rgba(6, 55, 140, 0.55), transparent 62%),
      linear-gradient(150deg, var(--navy-ink) 0%, var(--navy) 78%, var(--navy-deep) 135%);
    color: var(--white);
    padding-block: 4.25rem 4.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 1fr);
    gap: 3.5rem;
    align-items: center;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* #A9C3F0 is 10.6:1 on --navy-ink */
    color: #A9C3F0;
    margin: 0 0 1.1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    position: relative;
  }

  .hero-eyebrow::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 32px;
    height: 2px;
    background: var(--orange);
  }

  .hero h1 {
    color: var(--white);
    font-size: clamp(2.35rem, 3.9vw, 3.35rem);
    line-height: 1.12;
    letter-spacing: -0.018em;
    max-width: 21em;
    margin-bottom: 1.1rem;
  }

  .hero-lede {
    color: #d7ddec;
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 62ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin: 1.75rem 0 1.25rem;
  }

  .hero-urgent {
    color: #d7ddec;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    margin: 0;
  }

  .hero-urgent a {
    /* White (8.5:1 on the gradient's lighter end) instead of brand orange,
       which drops to 2.88:1 there; the underline keeps the link identifiable
       without relying on color. */
    color: var(--white);
    font-weight: 600;
    text-decoration: underline;
    white-space: nowrap;
  }

  .hero-urgent a:hover {
    color: #d7ddec;
  }

  @media (max-width: 860px) {
    .hero { padding-block: 3rem 3.25rem; }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .more-services {
    color: var(--ink-soft);
    margin: 0;
  }

  .coordinated {
    background: var(--white);
    border-block: 1px solid var(--line);
    padding-block: 3rem;
  }

  .coordinated p {
    max-width: 68ch;
  }

  .coordinated .btn {
    margin-top: 0.5rem;
  }

  .matters-grid {
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0.9rem;
    margin: 1.75rem 0;
  }

  .matters-grid :global(.card) {
    padding: 1.1rem 1.25rem;
  }

  .matters-grid :global(.card h3) {
    margin: 0;
    font-size: 1.08rem;
  }

  .coverage {
    background: #eef1f7;
    border-block: 1px solid var(--line);
    padding-block: 3rem;
  }

  .coverage p {
    max-width: 68ch;
  }

  .section-link {
    margin: 0.5rem 0 0;
  }
</style>
