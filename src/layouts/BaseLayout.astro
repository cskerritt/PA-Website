---
import { SITE } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { assetVer } from '../lib/assetVer';
import '../styles/global.css';

const revealSrc = `/scripts/reveal.js?v=${assetVer('scripts/reveal.js')}`;

interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
  /**
   * Keep this page out of search indexes (form-success and error pages).
   * Noindexed pages are also excluded from sitemap.xml by hand; the sitewide
   * suite asserts the two lists agree.
   */
  noindex?: boolean;
}

const { title, description, path, jsonld = [], noindex = false } = Astro.props;
const fullTitle = path === '/' ? title : `${title} | ${SITE.brand}`;
const canonical = SITE.domain + path;
const ogImage = `${SITE.domain}/assets/img/og-default.png`;

// The Expert Report type system: Newsreader (display), Public Sans (body),
// IBM Plex Mono (labels, numerals, legal lines). Self-hosted subset WOFF2s
// (public/assets/fonts/, @font-face in global.css) with same-origin preloads,
// so the brand serif is ready at first paint instead of swap-flashing in
// from a Google Fonts round-trip.
const preloadFonts = [
  '/assets/fonts/newsreader-var-latin.woff2',
  '/assets/fonts/public-sans-var-latin.woff2',
  '/assets/fonts/ibm-plex-mono-400-latin.woff2',
  '/assets/fonts/ibm-plex-mono-500-latin.woff2',
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#012262" />
    {preloadFonts.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
    {jsonld.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline src={revealSrc} defer></script>
  </body>
</html>
