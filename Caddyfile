{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	# Hashed build assets never change at their URL; everything else
	# revalidates hourly.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path /_astro/*
	header @unhashed Cache-Control "public, max-age=3600"

	# Clean URLs: /services/ resolves to /services/index.html.
	try_files {path} {path}/index.html

	file_server

	# Branded error page, served with the original error status code.
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}
}
